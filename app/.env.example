DATABASE_URL=sqlite:///./data.db
# Obligatoire en production: sans lui un secret aleatoire est genere a chaque
# demarrage et toutes les sessions sont invalidees.
JWT_SECRET=
AUTH_TOKEN_TTL_HOURS=8
# Origines autorisees pour le navigateur, separees par des virgules.
CORS_ORIGINS=http://localhost:5173
# Fuseau utilise pour "a venir" / "passees".
TZ=Europe/Paris
RESTAURANT_NAME=Albert
RESTAURANT_LOGO=assets/logo.png
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
