# ---- OS / IDE ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.venv/
venv/

data.db

# ---- Env files ----
.env
.env.*
!.env.example
!app/.env.example

# ---- Node / Vite (frontend) ----
app/frontend/node_modules/
app/frontend/dist/
*.local

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Generated assets ----
app/generated_pdfs/*.pdf

# ---- Donnees clients ----
# Les listes de reservations exportees contiennent des noms et des numeros de
# telephone de clients reels: elles ne doivent jamais partir sur le depot.
# Les PDF versionnes volontairement (carte des boissons) vivent sous app/.
/*.pdf

# ---- Copie obsolete du plan de salle ----
# L'outil vivant est sous app/. plant/ est un ancien instantane conserve en
# local uniquement, pour eviter qu'il soit edite par erreur.
plant/

# ---- Reglages locaux de l'outillage ----
.claude/settings.local.json
