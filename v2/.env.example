# Production (Railway ou autre). Ne jamais versionner les vraies valeurs.
APP_ENV=production
# Base PostgreSQL (Railway la fournit) — prendre une NOUVELLE base, distincte de l'ancienne version.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/albert_v2
# Secret long et aléatoire : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Adresse publique du site, en https (sert au connecteur ChatGPT et aux liens PDF).
PUBLIC_BASE_URL=https://albert-v2.exemple.be
TZ_RESTAURANT=Europe/Brussels
SESSION_HEURES=12
